# Hostname Caddy serves and requests a certificate for.
#
# sslip.io resolves any embedded IP back to itself, which gives a bare-IP VPS a
# real DNS name and therefore a real Let's Encrypt certificate — no domain
# purchase needed. Replace the IP with yours, keeping the dashes.
# Own a domain? Point it at the VPS and use it here instead.
SITE_ADDRESS=193-24-120-105.sslip.io

BASIC_AUTH_USER=admin

# bcrypt hash of your password, NOT the password itself. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_HASH=paste-the-hash-here
